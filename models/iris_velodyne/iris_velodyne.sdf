<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iris_velodyne">
    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <uri>model://velodyne_vlp16</uri>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

    <joint name="velodyne_joint" type="fixed">
      <parent>iris::base_link</parent>
      <child>velodyne_vlp16::link</child>
    </joint>
  </model>
</sdf>
