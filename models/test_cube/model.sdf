<?xml version="1.0"?>
<sdf version="1.7">

  <model name="test_cube">

    <static>false</static>

    <link name="link">

      <inertial>
        <mass>0.01</mass>

        <inertia>
          <!-- Uniform 20 mm cube, 10 g: I = mass * side^2 / 6. -->
          <ixx>6.6666666667e-7</ixx>
          <iyy>6.6666666667e-7</iyy>
          <izz>6.6666666667e-7</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.02 0.02 0.02</size>
          </box>
        </geometry>

        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.02 0.02 0.02</size>
          </box>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>

          <contact>
            <ode>
              <min_depth>0.0005</min_depth>
              <max_vel>0.05</max_vel>
            </ode>
          </contact>

        </surface>
      </collision>

    </link>

  </model>

</sdf>
