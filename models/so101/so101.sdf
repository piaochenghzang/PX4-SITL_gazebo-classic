      <pose>-0.0079 -0.000218 -0.098127 3.14159 3e-06 3.14159</pose>
    </frame>
    <frame name="gripper_frame_link" attached_to="gripper_frame_joint">
      <pose>0 0 0 0 -0 0</pose>
    </frame>
